{
  "alerts": "direct",
  "tasks": [
    {
      "name": "watch",
      "every_seconds": 300,
      "run": ["~/agent/code/.venv/bin/python3", "~/agent/code/watch.py"]
    },
    {
      "name": "source-check",
      "at": ["00:15"],
      "days": ["sun"],
      "timeout": 3600,
      "retries": 16,
      "retry_after": 1800,
      "run": ["~/agent/code/.venv/bin/python3", "~/agent/code/dream.py", "--source-check"]
    },
    {
      "name": "knowledge-review",
      "at": ["01:00"],
      "days": ["sun"],
      "timeout": 9000,
      "retries": 16,
      "retry_after": 1800,
      "run": ["~/agent/code/.venv/bin/python3", "~/agent/code/dream.py", "--review"]
    },
    {
      "name": "dream",
      "at": ["03:30"],
      "timeout": 9000,
      "retries": 16,
      "retry_after": 1800,
      "run": ["~/agent/code/.venv/bin/python3", "~/agent/code/dream.py"]
    },
    {
      "name": "logs",
      "at": ["04:30"],
      "run": ["~/agent/code/.venv/bin/python3", "~/agent/code/logs.py"]
    }
  ]
}
